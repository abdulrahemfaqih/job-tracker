# Database Configuration
# Untuk pengembangan lokal tanpa akun Turso, biarkan default 'file:jobtracker.db'
# Untuk Turso cloud:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
TURSO_DATABASE_URL=file:jobtracker.db
TURSO_AUTH_TOKEN=

# Auth Secret (minimal 32 karakter acak untuk HMAC SHA256 di jose)
JWT_SECRET=job_tracker_super_secret_jwt_key_2026_change_in_production
